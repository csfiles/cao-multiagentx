FROM python:3.12-slim

WORKDIR /app

# Install uv for fast dependency installation
RUN pip install uv --no-cache-dir

# Copy only what's needed for the MCP server
COPY mcp/ mcp/
COPY data/ data/
COPY mcp/customer_support_server/pyproject.toml /app/pyproject.toml

# Install dependencies
RUN uv pip install --system mcp>=1.0.0 pydantic>=2.0.0 python-dotenv>=1.0.0

ENV SUPPORTMESH_MCP_HOST=0.0.0.0
ENV SUPPORTMESH_MCP_PORT=8765
ENV SUPPORTMESH_DATA_DIR=/app/data

EXPOSE 8765

CMD ["python", "-m", "mcp.customer_support_server.server"]
